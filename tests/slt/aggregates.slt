query TII rowsort
SELECT region, count(*), sum(units) FROM sales GROUP BY region
----
NULL 1 1
east 2 15
north 1 NULL
west 2 10

query TTI
SELECT region, product, sum(units) FROM sales GROUP BY region, product ORDER BY region, product
----
east a 10
east b 5
north c NULL
west a 10
NULL a 1

query TI
SELECT region, sum(units) AS total FROM sales GROUP BY region HAVING sum(units) > 5 ORDER BY total DESC
----
east 15
west 10

query TR
SELECT product, avg(amount) FROM sales GROUP BY 1 ORDER BY 1
----
a 57.25
b 20
c 5

query II
SELECT count(DISTINCT product), count(DISTINCT region) FROM sales
----
3 3

query IIT
SELECT count(*), sum(units), max(region) FROM sales WHERE units > 100
----
0 NULL NULL

query T
SELECT region FROM sales GROUP BY region ORDER BY count(*) DESC, region LIMIT 2
----
east
west

query TI
SELECT upper(region) AS r, units / 2 AS h FROM sales GROUP BY region, units ORDER BY r, h
----
