CREATE TABLE sales (region TEXT, product TEXT, units INT, amount FLOAT8)

statement ok
INSERT INTO sales VALUES ('east', 'a', 10, 100.5), ('east', 'b', 5, 20), ('west', 'a', 7, 70.25), ('west', 'a', 3, NULL), ('north', 'c', NULL, 5), (NULL, 'a', 1, 1)

query IIIRR
SELECT count(*), count(units), sum(units), sum(amount), avg(amount) FROM sales
----
6 5 26 196.75 39.35

query ITTRR
SELECT min(units), min(region), max(product), max(amount), min(amount) FROM sales
----
